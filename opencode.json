{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "python-refactoring": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "git+https://github.com/slamer59/mcp-python-refactoring.git",
                "python-refactor",
                "server"
            ],
            "enabled": true
        },
        "sequential-thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true
        },
        "context7": {
            "type": "local",
            "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
            "enabled": false
        },
        "augment-context-engine": {
            "type": "local",
            "command": ["auggie", "--mcp", "--mcp-auto-workspace"],
            "enabled": true
        }
    }
}
